Screen {
    layers: base modal;
    background: $surface;
}

#status-bar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#status {
    width: 1fr;
    height: 1;
    overflow: hidden;
}

#status-brand {
    width: 13;
    height: 1;
    text-align: right;
}

#workspace {
    height: 1fr;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1fr 1fr;
    grid-gutter: 0;
}

#workspace.layout-radio {
    grid-columns: 3fr 2fr;
    grid-rows: 1fr 2fr;
}

#workspace.layout-chat {
    grid-columns: 2fr 3fr;
    grid-rows: 1fr 1fr;
}

#workspace.layout-route {
    grid-columns: 2fr 3fr;
    grid-rows: 2fr 3fr;
}

NodeTable {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    padding: 0;
    scrollbar-size-vertical: 1;
}

StatsPane {
    display: none;
}

PacketFeed {
    height: 3fr;
    border: none;
    border-title-align: left;
    padding: 0;
    scrollbar-size-vertical: 1;
}

PacketWorkbench, RoutePane {
    height: 1fr;
    width: 1fr;
    border: round $primary;
    border-title-align: left;
}

#packet-hex {
    height: 2fr;
    min-height: 7;
    padding: 0 1;
    background: $panel 45%;
    overflow: hidden;
}

#route-chain {
    height: auto;
    max-height: 4;
    padding: 0 1;
    background: $panel 45%;
}

#route-canvas {
    height: 1fr;
    min-height: 5;
    padding: 0 1;
    border: none;
}

#route-hops {
    height: 8;
    min-height: 4;
    border: none;
    scrollbar-size-vertical: 1;
}

#route-prefix {
    height: auto;
    max-height: 3;
    padding: 0 1;
    background: $panel 45%;
}

PacketFeed > .datatable--cursor {
    background: $accent 30%;
    color: $text;
}

ChatPane {
    height: 1fr;
    min-height: 12;
    border: round $primary;
    border-title-align: left;
}

#chat-header {
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text;
}

#chat-log {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* Scoped deliberately: a bare `*:focus-within` also lights up the layout
   containers, drawing spurious nested frames around every pane. */
NodeTable:focus,
StatsPane:focus,
PacketFeed:focus,
ChatPane:focus-within,
PacketWorkbench:focus-within,
RoutePane:focus-within {
    border: round $accent;
}

CommandPalette {
    align: center top;
    padding-top: 3;
    background: $surface 65%;
}

#palette-box {
    width: 82;
    height: 22;
    border: tall $accent;
    background: $panel;
    padding: 0 1;
}

#palette-title {
    height: 2;
    padding: 0 1;
    color: $text;
    text-style: bold;
}

#palette-input {
    height: 3;
    border: tall $primary;
}

#palette-results {
    height: 1fr;
    border: none;
    scrollbar-size-vertical: 1;
}

#palette-help {
    height: 1;
    color: $text-muted;
}

ScopeScreen {
    align: center middle;
    background: $surface 65%;
}

#scope-box {
    width: 88;
    height: auto;
    max-height: 18;
    border: heavy $primary;
    background: $surface;
    padding: 1 2;
}

#scope-title {
    height: 2;
    color: $accent;
    text-style: bold;
}

#scope-current, #scope-help {
    height: auto;
    margin: 1 0;
}

#scope-actions {
    height: 3;
    margin-top: 1;
}

#scope-actions Button {
    width: 1fr;
    margin-right: 1;
}

RoomScreen { background: $surface; }

#room-status {
    height: 1;
    padding: 0 1;
    background: $panel;
}

#room-main { height: 1fr; }

#room-list {
    width: 34;
    height: 1fr;
    border: round $primary;
}

#room-right { width: 1fr; }

#room-posts {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#room-login-row, #room-post-row { height: 3; }

#room-password, #room-post { width: 1fr; }

#room-login { width: 20; }

#room-logout, #room-send { width: 12; }

NodeDetail {
    align: center middle;
    background: $surface 60%;
}

#detail-box {
    width: 62;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $panel;
    border: round $accent;
}

#detail-help {
    margin-top: 1;
}

MapScreen {
    background: $surface;
}

#map-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

MapView {
    height: 1fr;
    width: 1fr;
    background: $surface;
}

PacketInspector {
    align: center middle;
    background: $surface 60%;
}

#inspect-box {
    width: 86;
    height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $accent;
    scrollbar-size-vertical: 1;
}

#inspect-help {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
}

HelpScreen {
    align: center middle;
    background: $surface 60%;
}

AboutScreen {
    align: center middle;
    background: $surface 65%;
}

#about-box {
    width: 82;
    max-width: 96%;
    height: 26;
    max-height: 90%;
    background: $panel;
    border: round $accent;
}

#about-scroll {
    height: 1fr;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

#about-body {
    width: 1fr;
    height: auto;
}

#about-foot {
    height: 1;
    background: $boost;
    color: $text-muted;
}

#help-box {
    width: 72;
    height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $accent;
    scrollbar-size-vertical: 1;
}

#help-foot {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
}

AuditScreen {
    background: $surface;
}

#audit-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#audit-box {
    height: 1fr;
    padding: 1 2;
    background: $surface;
    scrollbar-size-vertical: 1;
}

RelayScreen, SensorScreen {
    background: $surface;
}

PathScreen { background: $surface; }

#paths-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#paths-main { height: 1fr; }

#paths-table {
    width: 78;
    height: 100%;
    border: round $primary 40%;
    scrollbar-size-vertical: 1;
}

#paths-side {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

#paths-canvas {
    height: 1fr;
    min-height: 10;
    border: round $primary 40%;
    padding: 0 1;
}

#paths-detail {
    height: auto;
    max-height: 45%;
    padding: 1 1;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

#relay-status, #sensor-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#relay-box, #sensor-box {
    height: 1fr;
    padding: 1 2;
    background: $surface;
    scrollbar-size-vertical: 1;
}

AdminScreen { background: $surface; }

#admin-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#admin-main { height: 1fr; }

#admin-left { width: 52; }
#admin-right { width: 1fr; }

#admin-nodes {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    scrollbar-size-vertical: 1;
}

#admin-hints {
    height: 21;
    border: round $primary;
    padding: 0 1;
}

#admin-log {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#admin-input {
    height: 3;
    border: none;
    border-top: solid $primary-darken-2;
    background: $surface;
    padding: 0 1;
}

#admin-input:focus { background: $boost; }

ChannelScreen { background: $surface; }

#chan-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#chan-main { height: 1fr; }
#chan-left { width: 44; }
#chan-right { width: 1fr; }

#chan-table {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    scrollbar-size-vertical: 1;
}

#chan-log {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#chan-input {
    height: 3;
    border: none;
    border-top: solid $primary-darken-2;
    background: $surface;
    padding: 0 1;
}

#chan-input:focus { background: $boost; }

/* ---- pop-out chat overlay ---- */
ChatScreen { background: $surface; }

#ov-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#ov-main { height: 1fr; }

#ov-side { width: 26; }

#ov-list {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    background: $surface;
    scrollbar-size-vertical: 1;
}

#ov-list > ListItem {
    padding: 0 1;
}

#ov-list > ListItem.--highlight {
    background: $accent 35%;
}

#ov-right { width: 1fr; }

#ov-log {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    padding: 0 2;
    scrollbar-size-vertical: 1;
}

#ov-compose {
    height: 5;
}

#ov-input {
    width: 1fr;
    height: 5;
    border: round $primary-darken-2;
    background: $surface;
    padding: 0 1;
}

#ov-input:focus { background: $boost; }

#ov-preview {
    width: 48;
    height: 5;
    border: round $primary-darken-2;
    background: $panel;
    padding: 0 1;
    overflow: hidden;
}
