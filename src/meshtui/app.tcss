Screen {
    layers: base modal;
    background: $surface;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#main {
    height: 1fr;
}

#left {
    width: 64;
    min-width: 34;
}

#right {
    width: 1fr;
}

NodeTable {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    padding: 0;
    scrollbar-size-vertical: 1;
}

StatsPane {
    height: 13;
    border: round $primary;
    border-title-align: left;
    padding: 0 1;
}

PacketFeed {
    height: 2fr;
    border: round $primary;
    border-title-align: left;
    padding: 0;
    scrollbar-size-vertical: 1;
}

PacketFeed > .datatable--cursor {
    background: $accent 30%;
    color: $text;
}

ChatPane {
    height: 1fr;
    min-height: 12;
    border: round $primary;
    border-title-align: left;
}

#chat-header {
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text;
}

#chat-log {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

/* Scoped deliberately: a bare `*:focus-within` also lights up the layout
   containers, drawing spurious nested frames around every pane. */
NodeTable:focus,
StatsPane:focus,
PacketFeed:focus,
ChatPane:focus-within {
    border: round $accent;
}

NodeDetail {
    align: center middle;
    background: $surface 60%;
}

#detail-box {
    width: 62;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $panel;
    border: round $accent;
}

#detail-help {
    margin-top: 1;
}

MapScreen {
    background: $surface;
}

#map-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

MapView {
    height: 1fr;
    width: 1fr;
    background: $surface;
}

PacketInspector {
    align: center middle;
    background: $surface 60%;
}

#inspect-box {
    width: 86;
    height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $accent;
    scrollbar-size-vertical: 1;
}

#inspect-help {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
}

HelpScreen {
    align: center middle;
    background: $surface 60%;
}

#help-box {
    width: 72;
    height: 80%;
    padding: 1 2;
    background: $panel;
    border: round $accent;
    scrollbar-size-vertical: 1;
}

#help-foot {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
}

AuditScreen {
    background: $surface;
}

#audit-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#audit-box {
    height: 1fr;
    padding: 1 2;
    background: $surface;
    scrollbar-size-vertical: 1;
}

RelayScreen, SensorScreen {
    background: $surface;
}

PathScreen { background: $surface; }

#paths-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#paths-main { height: 1fr; }

#paths-table {
    width: 78;
    height: 100%;
    border: round $primary 40%;
    scrollbar-size-vertical: 1;
}

#paths-side {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

#paths-canvas {
    height: 1fr;
    min-height: 10;
    border: round $primary 40%;
    padding: 0 1;
}

#paths-detail {
    height: auto;
    max-height: 45%;
    padding: 1 1;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

#relay-status, #sensor-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#relay-box, #sensor-box {
    height: 1fr;
    padding: 1 2;
    background: $surface;
    scrollbar-size-vertical: 1;
}

AdminScreen { background: $surface; }

#admin-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#admin-main { height: 1fr; }

#admin-left { width: 52; }
#admin-right { width: 1fr; }

#admin-nodes {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    scrollbar-size-vertical: 1;
}

#admin-hints {
    height: 21;
    border: round $primary;
    padding: 0 1;
}

#admin-log {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#admin-input {
    height: 3;
    border: none;
    border-top: solid $primary-darken-2;
    background: $surface;
    padding: 0 1;
}

#admin-input:focus { background: $boost; }

ChannelScreen { background: $surface; }

#chan-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#chan-main { height: 1fr; }
#chan-left { width: 44; }
#chan-right { width: 1fr; }

#chan-table {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    scrollbar-size-vertical: 1;
}

#chan-log {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#chan-input {
    height: 3;
    border: none;
    border-top: solid $primary-darken-2;
    background: $surface;
    padding: 0 1;
}

#chan-input:focus { background: $boost; }

/* ---- pop-out chat overlay ---- */
ChatScreen { background: $surface; }

#ov-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#ov-main { height: 1fr; }

#ov-side { width: 26; }

#ov-list {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    background: $surface;
    scrollbar-size-vertical: 1;
}

#ov-list > ListItem {
    padding: 0 1;
}

#ov-list > ListItem.--highlight {
    background: $accent 35%;
}

#ov-right { width: 1fr; }

#ov-log {
    height: 1fr;
    border: round $primary;
    border-title-align: left;
    padding: 0 2;
    scrollbar-size-vertical: 1;
}

#ov-input {
    height: 3;
    border: round $primary-darken-2;
    background: $surface;
    padding: 0 1;
}

#ov-input:focus { background: $boost; }
